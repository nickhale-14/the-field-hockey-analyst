# MySQL (db container)
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=hockey_stats
MYSQL_USER=hockey_stats
MYSQL_PASSWORD=changeme
MYSQL_HOST_PORT=3307

# Ingest service connection string (ingest container talks to host "db")
DATABASE_URL=mysql+pymysql://hockey_stats:changeme@db:3306/hockey_stats?charset=utf8mb4

# Ingestion settings
LOG_LEVEL=INFO

# England Hockey API (used when INGEST_SOURCE=eh_api)
# Requires an England Hockey API key.
EH_API_BASE_URL=https://ehdwapi.englandhockey.co.uk/api
EH_API_KEY=your_api_key_here
EH_SEASON_ID=
EH_COMPETITION_ID=
EH_PAGE_SIZE=100
EH_FETCH_FIXTURE_DETAILS=true
EH_REQUEST_TIMEOUT_SECONDS=30

# MCP server connection (read-only user — SELECT only; create with mcp/README.md)
MCP_DATABASE_URL=mysql+pymysql://hockey_reader:changeme@127.0.0.1:3307/hockey_stats?charset=utf8mb4

# MCP server users (static bearer tokens): user:role:token, ";"-separated. Roles: viewer, analyst, admin.
# Generate a token with: openssl rand -hex 24
MCP_USERS="you:admin:changeme;someone:analyst:changeme"

# Supabase project "fha" (FHA Predictor and future accounts). Ref is not secret; the rest are.
SUPABASE_PROJECT_REF=<supabase-project-ref>
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_SERVICE_ROLE_KEY=your-secret-key   # the sb_secret_... key (Project Settings > API Keys); bypasses RLS, never commit
